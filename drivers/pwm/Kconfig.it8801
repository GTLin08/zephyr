config PWM_ITE_IT8801
	bool "ITE IT8801 PWM device driver"
	default y
	depends on DT_HAS_ITE_IT8801_PWM_ENABLED
	select I2C
	select MFD
	help
	   Enable driver for ITE IT8801 I2C-based PWM.
	   Supports 7 open-drain/push-pull outputs.

if PWM_ITE_IT8801

config PWM_IT8801_INIT_PRIORITY
	int "IT8801 PWM port init priority"
	default 85
	help
	  IT8801 PWM device driver initialization priority. The priority
	  must be lower than MFD_INIT_PRIORITY device.

endif # PWM_ITE_IT8801
