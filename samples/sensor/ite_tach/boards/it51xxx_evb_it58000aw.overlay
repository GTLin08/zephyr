&tach4 {
	status = "okay";
	pulses-per-round = <2>;
	/* IT51XXX_TACH_INPUT_PIN_A: tach4a_gpa5_default
	 * IT51XXX_TACH_INPUT_PIN_B: tach4b_gpn5_default
	 */
	input-pin = <IT51XXX_TACH_INPUT_PIN_A>;
	pinctrl-0 = <&tach4a_gpa5_default>;
	pinctrl-names = "default";
