/ {
	aliases {
		tach-test = &tach0;
		pwm-test = &pwm0;
	};

};

&pwm0 {
	status = "okay";
	prescaler-cx = <PWM_PRESCALER_C6>;
	pinctrl-0 = <&pwm0_gpa0_default>;
	pinctrl-names = "default";
};

&tach0 {
	status = "okay";
	pulses-per-round = <2>;
	/* IT51XXX_TACH_INPUT_PIN_A: tach0a_gpd6_default
	 * IT51XXX_TACH_INPUT_PIN_B: tach0b_gpc6_default
	 */
	input-pin = <IT51XXX_TACH_INPUT_PIN_B>;
	pinctrl-0 = <&tach0b_gpc6_default>;
	pinctrl-names = "default";
};

&tach1 {
	status = "okay";
	pulses-per-round = <2>;
	/* IT51XXX_TACH_INPUT_PIN_A: tach1a_gpd7_default
	 * IT51XXX_TACH_INPUT_PIN_B: tach1b_gpj6_default
	 */
	input-pin = <IT51XXX_TACH_INPUT_PIN_B>;
	pinctrl-0 = <&tach1a_gpd7_default>;
	pinctrl-names = "default";
};

